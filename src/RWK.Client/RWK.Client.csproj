<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RWK.Client</RootNamespace>
    <AssemblyName>RWKClient</AssemblyName>

    <!-- Single-file, self-contained win-x64 publish so the operator gets one .exe
         with no prerequisite install (matches the v1 app's publish shape). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Product>RWK Client</Product>
    <ApplicationIcon>..\..\rwk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI output for the local sidetone engine (Requirement 4). Pinned: envelope
         and buffer behavior are timing-sensitive. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Standard serial port class for WinKeyer protocol host (Port B, 1200 baud).
         Not timing-critical, so System.IO.Ports is adequate here (2.1). -->
    <PackageReference Include="System.IO.Ports" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RWK.Shared\RWK.Shared.csproj" />
    <!-- TEMPORARY: WinKeyerProtocol has not been ported to RWK.Shared yet.
         This reference provides the WK2 state machine for WinKeyerProtocolHost.
         Remove at task 20.1 when the protocol engine is relocated. -->
    <ProjectReference Include="..\WinKeyerEmulator.Core\WinKeyerEmulator.Core.csproj" />
  </ItemGroup>

</Project>
